// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum BookingStatus {
  PENDING
  PAID
  CANCELLED
  COMPLETED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String
  role          Role      @default(USER)
  image         String?
  bookings      Booking[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Motorbike {
  id            String    @id @default(cuid())
  name          String
  brand         String
  model         String
  year          Int
  pricePerDay   Float
  imageUrl      String
  description   String    @db.Text
  status        String    @default("available") // available, maintenance, rented
  bookings      Booking[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Booking {
  id            String        @id @default(cuid())
  userId        String
  motorbikeId   String
  startDate     DateTime
  endDate       DateTime
  totalPrice    Float
  status        BookingStatus @default(PENDING)
  paymentId     String?       // Dummy payment ID
  user          User          @relation(fields: [userId], references: [id])
  motorbike     Motorbike     @relation(fields: [motorbikeId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model LandingPageConfig {
  id                String   @id @default("default")
  // Hero
  heroTitle         String
  heroSubtitle      String
  heroImage         String
  
  // Branding
  brandName         String   @default("SEWA MOTOR")
  brandDescription  String?  @db.Text

  // Contact
  contactEmail      String
  contactPhone      String
  address           String   @db.Text

  // Socials
  instagramUrl      String?
  twitterUrl        String?
  facebookUrl       String?

  // Features (up to 3)
  feature1Title     String?
  feature1Description String? @db.Text
  feature2Title     String?
  feature2Description String? @db.Text
  feature3Title     String?
  feature3Description String? @db.Text

  // Stats (up to 4)
  stat1Value        String?
  stat1Label        String?
  stat2Value        String?
  stat2Label        String?
  stat3Value        String?
  stat3Label        String?
  stat4Value        String?
  stat4Label        String?

  // Hero Extras
  heroBadge         String?  @default("Premium Rental Experience")
  heroButtonText    String?  @default("Jelajahi Armada")

  // Featured Section
  featuredSectionTitle    String? @default("Armada Favorit Musim Ini")
  featuredSectionSubtitle String? @default("Fleet selection")

  // CTA Section (Custom Request)
  ctaTitle          String? @default("Butuh Motor Custom Berbeda?")
  ctaDescription    String? @db.Text @default("Hubungi admin kami untuk permintaan unit khusus atau penyewaan jangka panjang.")
  ctaButtonText     String? @default("Chat WhatsApp Admin")

  updatedAt         DateTime @updatedAt
}

model SystemConfig {
  id                  String   @id @default("default")
  paymentGatewayMode  String   @default("dummy") // dummy, production
  paymentInstructions String   @db.Text
  maintenanceMode     Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}
